:root{--color-ink:#171310;--color-panel:#221c16;--color-line:#342a20;--color-text:#e8e2da;--color-muted:#9a9086;--amber:#ffa028;--lightningcss-light: ;--lightningcss-dark:initial;color-scheme:dark}*{box-sizing:border-box}html,body{background:var(--color-ink);color:var(--color-text);margin:0;padding:0;font:15px/1.45 system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Noto Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif}#app{flex-direction:column;height:100vh;display:flex}.dim{color:var(--color-muted)}.btn{border:1px solid var(--color-line);background:var(--color-panel);color:var(--color-text);cursor:pointer;border-radius:999px;align-items:center;gap:6px;padding:8px 14px;font-size:13.5px;display:inline-flex}.btn:hover{background:var(--color-ink)}.btn.amber{background:var(--amber);border-color:var(--amber);color:#17110a;font-weight:700}.btn:disabled{opacity:.5;cursor:default}.btn.tiny{padding:4px 10px;font-size:12px}input[type=text],textarea{background:var(--color-panel);border:1px solid var(--color-line);color:var(--color-text);font:inherit;-webkit-appearance:none;appearance:none;border-radius:12px;padding:10px 14px;font-size:14px;line-height:1.2}input:focus,textarea:focus{border-color:var(--amber);outline:none}button{font:inherit}.blayout{flex:1;min-height:0;display:flex}.bside{border-right:1px solid var(--color-line);background:var(--color-panel);flex-direction:column;flex:none;width:250px;display:flex;overflow-y:auto}.bsidehead{align-items:center;gap:8px;padding:16px 14px 8px;display:flex}.bsidehead h1{margin:0;font-size:19px;font-weight:800}.bmark{color:var(--amber);font-size:19px;font-weight:900}.bsec{text-transform:uppercase;letter-spacing:.08em;color:var(--color-muted);justify-content:space-between;align-items:center;padding:10px 14px 4px;font-size:11px;display:flex}.bsec button{color:var(--amber);cursor:pointer;background:0 0;border:0;padding:0 2px;font-size:15px}.broom{width:100%;color:var(--color-text);text-align:left;cursor:pointer;background:0 0;border:0;align-items:center;gap:9px;padding:7px 14px;font-size:14px;display:flex}.broom:hover{background:var(--color-ink)}.broom.on{background:var(--color-ink);box-shadow:inset 2px 0 0 var(--amber)}.bricon{background:var(--color-line);border-radius:8px;flex:none;justify-content:center;align-items:center;width:26px;height:26px;font-size:14px;display:flex;overflow:hidden}.bricon img{object-fit:cover;width:100%;height:100%}.broom span{text-overflow:ellipsis;white-space:nowrap;overflow:hidden}.bme{border-top:1px solid var(--color-line);align-items:center;gap:9px;margin-top:auto;padding:10px 14px;display:flex}.bavatar{background:var(--color-line);width:30px;height:30px;color:var(--color-muted);border-radius:999px;flex:none;justify-content:center;align-items:center;font-size:13px;display:flex;overflow:hidden}.bavatar img{object-fit:cover;width:100%;height:100%}.bbadge{background:var(--amber);color:#17110a;border-radius:999px;margin-left:auto;padding:1px 7px;font-size:11px;font-weight:700}.bmain{flex-direction:column;flex:1;min-width:0;display:flex}.bchathead{border-bottom:1px solid var(--color-line);align-items:center;gap:10px;padding:12px 18px;display:flex}.bchathead h2{margin:0;font-size:16px}.bchathead .spacer{flex:1}.bmsgs{flex-direction:column;flex:1;gap:10px;padding:14px 18px;display:flex;overflow-y:auto}.bmsg{gap:10px;display:flex}.bmsgbody{min-width:0}.bmsgmeta{color:var(--color-muted);margin-bottom:1px;font-size:12px}.bmsgmeta b{color:var(--color-text);margin-right:6px}.bmsgtext{white-space:pre-wrap;word-wrap:break-word;font-size:14.5px}.bmsg img.bimg{border-radius:12px;max-width:min(360px,70vw);margin-top:4px;display:block}.binvite{border:1px solid var(--color-line);background:var(--color-panel);border-radius:12px;margin-top:4px;padding:10px 14px;display:inline-block}.bpoll{border:1px solid var(--color-line);background:var(--color-panel);border-radius:12px;max-width:380px;margin-top:4px;padding:12px 14px}.bpollq{margin-bottom:8px;font-weight:700}.bpollopt{text-align:left;border:1px solid var(--color-line);background:var(--color-ink);width:100%;color:var(--color-text);cursor:pointer;border-radius:10px;margin:4px 0;padding:8px 12px;display:block;position:relative;overflow:hidden}.bpollopt.mine{border-color:var(--amber)}.bpollbar{background:color-mix(in srgb, var(--amber) 22%, transparent);position:absolute;top:0;bottom:0;left:0}.bpollopt span{position:relative}.bcomposer{border-top:1px solid var(--color-line);align-items:center;gap:8px;padding:10px 18px 14px;display:flex}.bcomposer input[type=text]{flex:1;min-width:0}.biconbtn{border:1px solid var(--color-line);background:var(--color-panel);width:40px;height:40px;color:var(--color-text);cursor:pointer;border-radius:999px;flex:none;justify-content:center;align-items:center;font-size:17px;display:flex}.biconbtn:hover{border-color:var(--amber)}.boverlay{z-index:50;background:#0009;justify-content:center;align-items:center;padding:16px;display:flex;position:fixed;top:0;bottom:0;left:0;right:0}.bsheet{background:var(--color-panel);border:1px solid var(--color-line);border-radius:16px;width:100%;max-width:420px;max-height:84vh;padding:20px;overflow-y:auto}.bsheet h3{margin:0 0 12px;font-size:16px}.bsheet .row{gap:8px;margin:8px 0;display:flex}.bsheet .row input{flex:1;min-width:0}.bmember{align-items:center;gap:10px;padding:7px 0;display:flex}.bmember .spacer{flex:1}.bcenter{text-align:center;flex-direction:column;flex:1;justify-content:center;align-items:center;gap:14px;padding:20px;display:flex}.bgifs{grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px;display:grid}.bgifs button{background:var(--color-ink);cursor:pointer;border:0;border-radius:10px;padding:0;overflow:hidden}.bgifs img{width:100%;display:block}.bfriend{width:100%;color:var(--color-text);text-align:left;cursor:pointer;background:0 0;border:0;align-items:center;gap:10px;padding:7px 14px;font-size:14px;display:flex}.bfriend:hover{background:var(--color-ink)}@media (max-width:720px){.bside{z-index:30;transition:transform .2s;position:fixed;top:0;bottom:0;left:0;transform:translate(-100%)}.bside.open{transform:none}.bmenubtn{display:inline-flex!important}}.bmenubtn{border:1px solid var(--color-line);background:var(--color-panel);width:36px;height:36px;color:var(--color-text);cursor:pointer;border-radius:999px;flex:none;justify-content:center;align-items:center;font-size:16px;display:none}.bmain{min-width:0;overflow:hidden}.bcenter h1,.bcenter p{overflow-wrap:break-word;max-width:88vw}@media (max-width:720px){.bside.open{box-shadow:0 0 0 100vmax #0000008c}.bcenter>*{max-width:86vw}.blayout.sideopen .bmain{visibility:hidden}}.bbottag{color:var(--amber);border:1px solid var(--amber);text-transform:uppercase;letter-spacing:.04em;border-radius:5px;margin:0 6px;padding:0 5px;font-size:10px;font-weight:700}.bbotav{color:var(--amber);background:linear-gradient(135deg,#3a2c1c,#241b12)}.bcheck{cursor:pointer;align-items:center;gap:8px;margin:6px 0 10px;font-size:13.5px;display:flex}.bcheck input{accent-color:var(--amber);width:16px;height:16px}
